+            CURLOPT_LOW_SPEED_LIMIT => 1,
+            CURLOPT_LOW_SPEED_TIME => 120,
+            CURLOPT_WRITEFUNCTION => function ($curl, $chunk) use (&$buffer, $handleLine) {
+                $buffer .= $chunk;
+                while (($pos = strpos($buffer, "\n")) !== false) {
