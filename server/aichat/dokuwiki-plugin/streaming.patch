+            if (isset($piece['error'])) {
+                $error = is_array($piece['error']) ? $piece['error']['message'] : $piece['error'];
+                return;
+            }
+            if (($piece['message']['thinking'] ?? '') !== '') {
+                $onPiece('thinking', $piece['message']['thinking']);
+            }
+            if (($piece['message']['content'] ?? '') !== '') {
+                $answer .= $piece['message']['content'];
+                $onPiece('answer', $piece['message']['content']);
+            }
+            if (!empty($piece['done'])) {
+                $this->inputTokensUsed += $piece['prompt_eval_count'] ?? 0;
+                $this->outputTokensUsed += $piece['eval_count'] ?? 0;
+            }
+        };
+
+        $this->requestStart = microtime(true);
+        $this->requestsMade++;
+        $curl = curl_init($this->apiurl . '/chat');
+        curl_setopt_array($curl, [
