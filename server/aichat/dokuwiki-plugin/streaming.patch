+namespace dokuwiki\plugin\aichat\Model;
+
+/**
+ * A chat model that can hand out its reasoning and answer while they are generated
+ */
+interface StreamingChatInterface extends ChatInterface
+{
+    /**
+     * Answer a given question, passing each generated piece to a callback
+     *
+     * @param array $messages Messages in OpenAI format (with role and content)
+     * @param callable $onPiece Called as $onPiece(string $type, string $text), $type is 'thinking' or 'answer'
+     * @return string The complete answer
+     * @throws \Exception
+     */
+    public function streamAnswer(array $messages, callable $onPiece): string;
+}
